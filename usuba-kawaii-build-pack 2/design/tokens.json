{
  "$schema": "usuba-kawaii-tokens/v1",
  "note": "Generated from tokens.css. tokens.css is the source of truth.",
  "light": {
    "color": {
      "color-bg": "#ffe1ec",
      "color-bg-dot": "#ffc6da",
      "color-surface": "#fffaf3",
      "color-ink": "#4a2a3f",
      "color-ink-soft": "#5e3a52",
      "color-ink-deep": "#2e1828",
      "color-pink": "#ff9cbf",
      "color-pink-blush": "#ff9cbf",
      "color-pink-shadow": "#f7b3cb",
      "color-mint": "#bdeed8",
      "color-butter": "#ffe69a",
      "color-lilac": "#d9ccff",
      "color-chart-fixed": "#e0f5e9",
      "color-chart-dead": "#e7dbe3",
      "color-chart-grid": "#ecc9da",
      "color-steel": "#eef1f8",
      "color-steel-bevel": "#ccd3e6",
      "color-wood": "#e9b98a",
      "color-wood-grain": "#c99566",
      "color-code-bg": "#4a2a3f",
      "color-code-bar": "#5e3a52",
      "color-code-text": "#fffaf3",
      "color-code-prompt": "#ff9cbf",
      "color-code-success": "#bdeed8",
      "color-code-fail": "#ff9cbf",
      "color-code-warn": "#ffe69a",
      "color-code-hint": "#d9c4d1",
      "color-on-accent": "#4a2a3f",
      "color-outline": "#4a2a3f",
      "color-focus": "#4a2a3f"
    },
    "font": {
      "font-display": "\"M PLUS Rounded 1c\", \"Hiragino Maru Gothic ProN\", \"Arial Rounded MT Bold\", sans-serif",
      "font-body": "\"M PLUS Rounded 1c\", \"Hiragino Maru Gothic ProN\", \"Arial Rounded MT Bold\", sans-serif",
      "font-code": "\"M PLUS 1 Code\", ui-monospace, \"SFMono-Regular\", Menlo, monospace"
    },
    "weight": {
      "weight-body": "500",
      "weight-bold": "700",
      "weight-heavy": "800"
    },
    "text": {
      "text-sm": "0.9375rem",
      "text-base": "1.0625rem",
      "text-lg": "1.25rem",
      "text-xl": "1.5rem",
      "text-2xl": "clamp(1.875rem, 3.4vw, 2.75rem)",
      "text-3xl": "clamp(2.5rem, 5.4vw, 4.375rem)",
      "text-hero-long": "clamp(2.25rem, 4.6vw, 3.75rem)",
      "text-logo": "1.875rem"
    },
    "leading": {
      "leading-tight": "1.12",
      "leading-body": "1.6",
      "leading-lede": "1.65",
      "leading-code": "2"
    },
    "tracking": {
      "tracking-tight": "-0.015em"
    },
    "misc": {
      "measure": "30em",
      "border-width": "3px",
      "border": "var(--border-width) solid var(--color-outline)",
      "container": "1160px",
      "container-narrow": "920px",
      "container-code": "820px",
      "gutter": "28px",
      "tap-min": "48px",
      "dot-size": "30px"
    },
    "radius": {
      "radius-pill": "999px",
      "radius-card": "30px",
      "radius-window": "28px",
      "radius-icon": "50%"
    },
    "shadow": {
      "shadow-sm": "4px 4px 0 var(--color-outline)",
      "shadow-md": "5px 5px 0 var(--color-outline)",
      "shadow-lg": "6px 6px 0 var(--color-outline)",
      "shadow-window": "8px 8px 0 var(--color-pink)",
      "shadow-pressed": "1px 1px 0 var(--color-outline)"
    },
    "tilt": {
      "tilt-1": "-1.5deg",
      "tilt-2": "1deg",
      "tilt-3": "-0.6deg"
    },
    "space": {
      "space-1": "4px",
      "space-2": "8px",
      "space-3": "12px",
      "space-4": "16px",
      "space-5": "20px",
      "space-6": "24px",
      "space-7": "28px",
      "space-8": "32px",
      "space-10": "40px",
      "space-11": "44px",
      "space-12": "48px",
      "space-16": "64px",
      "space-22": "88px",
      "space-24": "96px"
    },
    "ease": {
      "ease-bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "duration": {
      "duration-press": "90ms",
      "duration-ui": "180ms",
      "duration-intro": "700ms"
    }
  },
  "dark": {
    "color-bg": "#2a1b28",
    "color-bg-dot": "#33212f",
    "color-surface": "#3b2638",
    "color-ink": "#fdeef4",
    "color-ink-soft": "#e6c9d8",
    "color-ink-deep": "#ffffff",
    "color-code-bg": "#1e131d",
    "color-code-bar": "#2e1d2b",
    "color-on-accent": "#2a1b28",
    "color-outline": "#1a0f19",
    "color-focus": "#ffe69a",
    "color-chart-grid": "#4b3346"
  }
