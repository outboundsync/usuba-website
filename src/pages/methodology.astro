---
import Button from '../components/Button.astro';
import Callout from '../components/Callout.astro';
import AuthorityStack from '../components/charts/AuthorityStack.astro';
import GraderVsReal from '../components/charts/GraderVsReal.astro';
import IntervalScoreboard from '../components/charts/IntervalScoreboard.astro';
import PairedMetrics from '../components/charts/PairedMetrics.astro';
import SweepBar from '../components/charts/SweepBar.astro';
import Timeline from '../components/charts/Timeline.astro';
import ValidatorVsReal from '../components/charts/ValidatorVsReal.astro';
import CodeWindow from '../components/CodeWindow.astro';
import CtaBand from '../components/CtaBand.astro';
import OutcomeChart from '../components/OutcomeChart.astro';
import Screenshot from '../components/Screenshot.astro';
import SpecChip from '../components/SpecChip.astro';
import Icon from '../components/Icon.astro';
import TestMachine from '../components/TestMachine.astro';
import Base from '../layouts/Base.astro';
import { METHODOLOGY } from '../data/methodology';
import { preliminaryLabel, RESULTS, rate } from '../data/results';
import { SAMPLE_OUTPUT_NOTE } from '../data/sample-output';
import { SITE } from '../data/site';

/*
 * The one long-form post: how Usuba was built and tested. A reading column for the words,
 * with figures that break out wider. Every number comes from results.json (exams) or
 * methodology.json (the story), both sourced from usuba-checker-scripts/docs/post.
 */
const { scripts, model, benchmark, exams, hardware, sweep } = RESULTS;
const label = preliminaryLabel(model.final);
const metric = (name: string, exam: string) => model.comparison.metrics.find((m) => m.label === name && m.exam === exam);
const acc = metric('Verdict accuracy', 'Dell 75');
const valid = metric('Valid answers', 'Dell 75');
const bestModel = RESULTS.scoreboard.rows.filter((row) => row.kind !== 'scripts').sort((a, b) => b.score.value - a.score.value)[0];
const best = [...benchmark.models].sort((a, b) => b.afterFixes - a.afterFixes)[0];
const fmt = (n: number) => n.toLocaleString('en-US');
const EXAM_ICONS = [
  { icon: 'laptop', tone: 'mint' },
  { icon: 'bug', tone: 'pink' },
  { icon: 'book', tone: 'lilac' },
  { icon: 'terminal', tone: 'butter' },
];
const cpu = hardware.specs.find((spec) => spec.label === 'CPU')?.value ?? '';

const STATS = [
  { value: rate(scripts.dell75.accuracy.value, 3), text: 'of verdicts right for the Checker Scripts on the Dell 75, with no model' },
  { value: acc ? rate(acc.run2.value) : '', text: `for Usuba run 2 on the same exam (its stock base: ${acc ? rate(acc.stock.value) : ''})` },
  { value: valid ? rate(valid.run2.value) : '', text: `run 2's rate of usable answers (stock: ${valid ? rate(valid.stock.value) : ''})` },
  { value: fmt(sweep.total), text: `plugin runs labelled on a ${hardware.name}` },
];

const TOC = [
  { id: 'start', label: 'Where this started' },
  { id: 'machine', label: 'The test machine' },
  { id: 'days', label: 'Six days, in order' },
  { id: 'lies', label: 'How a score can lie' },
  { id: 'exams', label: 'The four exams' },
  { id: 'sweep', label: 'Loading isn’t using' },
  { id: 'scripts', label: 'The Usuba Checker Scripts' },
  { id: 'model', label: 'The Usuba Checker Model' },
  { id: 'run', label: 'See it run' },
  { id: 'claims', label: 'What we’re releasing' },
  { id: 'took', label: 'What it took' },
  { id: 'help', label: 'Help us' },
];
---

<Base
  title="How Usuba was built and tested"
  image="/og-post.png"
  imageAlt="How Usuba was built and tested, by Harris Kenny, October 17, 2026. Preliminary results: 0.773 for the Checker Scripts on the Dell 75, 0.48 for Usuba run 2, and 5,532 plugin runs on a Dell Latitude 7430."
  ogType="article"
  description={`Six days, two training runs and thousands of plugins on a ${hardware.name}. How we test, what lied to us, and where the Usuba Checker Model stands. Preliminary results, October 2026.`}
>
  <article class="post">
    <header class="post__header">
      <p class="post__back"><a href="/">Usuba</a> / Post</p>
      <p class="post__meta">
        <time datetime="2026-10-17">October 17, 2026</time> · Harris Kenny · 12 min read
      </p>
      <h1 class="post__title">How Usuba was built and tested</h1>
      <p class="post__dek">
        We set out to train a small local model to write Omarchy plugins. Six days later, the most useful thing we had built was the
        test that tells you whether one works. Here&rsquo;s what we tried, the scores that lied to us, and where the model stands.
      </p>
      <p class="post__badges">
        <span class="badge badge--now">Checker Scripts v0.1.0: out now</span>
        <span class="badge badge--now">Checker Model v0.1.0: out now</span>
      </p>
    </header>

    <ul class="stat-strip post__wide">
      {
        STATS.map((stat) => (
          <li class="stat">
            <span class="stat__value">{stat.value}</span>
            <span class="stat__text">{stat.text}</span>
          </li>
        ))
      }
    </ul>
    <p class="chart__note chart__note--center">{label} Machine-drafted labels on small exam sets.</p>

    <div class="post__prose">
      <aside class="tldr" aria-labelledby="tldr-title">
        <h2 class="tldr__title" id="tldr-title">The short version</h2>
        <ol class="short-list">
          <li>
            <strong>Our first wins were measurement mistakes.</strong> A tuned 7B looked level with GPT-5.6 until we ran its plugins: 42 of
            56 became 8.
          </li>
          <li>
            <strong>So the test came first.</strong> We built a grader that agrees with a real laptop, and turned it into the Usuba Checker
            Scripts and a public standard of {scripts.ruleCount} rules.
          </li>
          <li>
            <strong>Plain code still judges best.</strong> On the Dell 75 the scripts get {rate(scripts.dell75.accuracy.value, 3)} of verdicts right
            with no model. The best model we tested reached {rate(bestModel.score.value)}, with the scripts&rsquo; help.
          </li>
          <li>
            <strong>The model is out, as an early v0.1.0.</strong> It answers in a usable form almost every time and catches more broken
            plugins than its base, but raises more false alarms. The Checker Scripts still make the call.
          </li>
        </ol>
      </aside>

      <nav class="toc" aria-label="In this post">
        <p class="toc__title">In this post</p>
        <ol>{TOC.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol>
      </nav>

      <h2 class="post__h2" id="start">Where this started</h2>
      <p>
        Omarchy moves fast, faster than the big models learn about it. Ask one for an Omarchy plugin and it fills the gaps with
        confident guesses: APIs that don&rsquo;t exist, programs that aren&rsquo;t installed, data it made up. The plugin looks right
        and does nothing.
      </p>
      <p>
        Coinbase had just written about post-training a small open model, Qwen3.5 9B, for one specialised job. Usuba is the same idea
        at a smaller scale: a model for Omarchy plugins that runs free on your own laptop. Coinbase is not a sponsor; its write-up is
        what prompted this.
      </p>

      <h2 class="post__h2" id="machine">The test machine</h2>
      <p>
        Everything rests on one laptop. When this post says a plugin &ldquo;works&rdquo; or is &ldquo;broken&rdquo;, it means we ran it
        on this {hardware.name} running Omarchy, and watched what happened.
      </p>
    </div>

    <div class="post__figure">
      <TestMachine />
    </div>

    <div class="post__prose">
      <p>That gives every verdict an order of authority. The real laptop outranks the Checker Scripts, and the scripts outrank the model.</p>
    </div>
    <div class="post__figure">
      <AuthorityStack />
    </div>

    <div class="post__prose">
      <h2 class="post__h2" id="days">Six days, October 11 to 16</h2>
      <p>Each step ran into the same wall from a different side: a number that looked good until something more real checked it.</p>
    </div>
    <div class="post__figure">
      <Timeline />
    </div>

    <div class="post__prose">
      <h2 class="post__h2" id="lies">How a score can lie</h2>
      <p>
        Every one of these happened to us. The first is why the project changed direction: a static validator only reads files, so it
        can call a plugin valid when it does nothing at all.
      </p>
    </div>
    <div class="post__wide chart-pair">
      <ValidatorVsReal />
      <GraderVsReal />
    </div>
    <div class="post__prose">
      <p>
        The second chart changed the plan. Given the grader&rsquo;s complaints and three tries, a model learned to satisfy the grader
        instead of the task: stripping out whatever failed, hardcoding the data, calling functions that don&rsquo;t exist on paths the
        grader never ran. Thirteen passes; four real.
      </p>
    </div>
    <div class="post__wide table-card">
      <table class="lies">
        <caption class="visually-hidden">Six scores that looked good, what exposed them, and the honest number</caption>
        <thead>
          <tr>
            <th scope="col">How it lied</th>
            <th scope="col">The flattering number</th>
            <th scope="col">What exposed it</th>
            <th scope="col">The honest number</th>
          </tr>
        </thead>
        <tbody>
          {
            METHODOLOGY.lies.map((lie) => (
              <tr>
                <th scope="row">{lie.how}</th>
                <td>{lie.flattering}</td>
                <td>{lie.exposed}</td>
                <td>
                  <strong>{lie.honest}</strong>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="post__prose">
      <h2 class="post__h2" id="exams">The four exams</h2>
      <p>
        Every number on this site comes from one of these. Each has a size, a source for its labels and a limit, and we name the exam
        wherever a number appears.
      </p>
    </div>
    <ul class="post__wide card-grid exam-grid">
      {
        exams.map((exam, index) => (
          <li class="card exam">
            <span class={`icon-badge icon-badge--${EXAM_ICONS[index % EXAM_ICONS.length].tone}`}>
              <Icon name={EXAM_ICONS[index % EXAM_ICONS.length].icon} />
            </span>
            <h3>{exam.name}</h3>
            <p class="exam__size">{exam.size}</p>
            <dl>
              <dt>Asks</dt>
              <dd>{exam.measures}</dd>
              <dt>Labelled by</dt>
              <dd>{exam.labels}</dd>
              <dt>Watch out</dt>
              <dd>{exam.limit}</dd>
            </dl>
          </li>
        ))
      }
    </ul>

    <div class="post__prose">
      <h2 class="post__h2" id="sweep">Loading isn&rsquo;t using</h2>
      <p>
        Next we stopped sampling and ran every plugin we could find on the {hardware.short}. One audio plugin rerouted the
        laptop&rsquo;s sound and the shell ran out of memory, so the runs moved into sandboxes and {sweep.rerun} jobs were redone.
      </p>
      <p>
        For loading, the scripts turned out stricter than the hardware: nothing they passed failed to load. For using, they
        weren&rsquo;t enough. {sweep.inUse.total} plugins passed the scripts and still broke when you clicked them.
      </p>
    </div>
    <div class="post__figure">
      <SweepBar />
    </div>

    <div class="post__prose">
      <h2 class="post__h2" id="scripts">The Usuba Checker Scripts <span class="badge badge--now">Available now</span></h2>
      <p>
        Plain Python, no AI: {scripts.ruleCount} rules in <a href={SITE.standardHref}>Usuba Standard v{scripts.standardVersion}</a>, each with an id,
        a reason and a fix. They agree with the hardware answer key on {scripts.keyAgreement} decided cases, and on the Dell 75 they get
        {' '}{rate(scripts.dell75.accuracy.value, 3)} of verdicts right. The static checks run on any machine; the real-shell run needs the
        reference Linux build. Here is real output from a broken test plugin:
      </p>
    </div>
    <div class="post__figure code-wrap">
      <CodeWindow />
      <p class="chart__note chart__note--center">{SAMPLE_OUTPUT_NOTE}</p>
    </div>
    <div class="post__prose">
      <p>
        Do they help models write plugins? Eleven models wrote the same 49 plugins, and the scripts&rsquo; report went back for up to
        three fix rounds. A plugin only passed if the scripts passed it, a code read agreed it did the job, and, where we could run
        it, it loaded on the {hardware.short}. Strong models gained most: {best.name} went from {best.firstTry} to {best.afterFixes}.
      </p>
    </div>
    <div class="post__figure">
      <OutcomeChart />
      <p class="chart__note chart__note--center"><a href={SITE.resultsHref}>The 49 requests, model by model.</a></p>
    </div>

    <div class="post__prose">
      <h2 class="post__h2" id="model">The Usuba Checker Model <span class="badge badge--now">v0.1.0</span></h2>
      <p>
        The case for a model isn&rsquo;t loading; the scripts do that. It&rsquo;s the review a person would do: is the data real, do
        the buttons do anything, does it break in use. Usuba run 2 is Qwen3.5 9B with a small LoRA adapter, trained on {model.run2.train}
        examples mined from real plugin git histories and the {hardware.short}. Here it is against the stock model it started from.
      </p>
    </div>
    <div class="post__figure">
      <SpecChip />
      <PairedMetrics />
    </div>
    <div class="post__prose">
      <ul class="verdict-list">
        <li>
          <span class="icon-badge icon-badge--mint icon-badge--sm"><Icon name="check" /></span>
          <span><strong>Better than its base:</strong> usable answers on every exam, about twice the broken plugins caught, and far fewer findings of its own.</span>
        </li>
        <li>
          <span class="icon-badge icon-badge--lilac icon-badge--sm"><Icon name="chart" /></span>
          <span><strong>On par:</strong> overall verdicts and bugs found.</span>
        </li>
        <li>
          <span class="icon-badge icon-badge--pink icon-badge--sm"><Icon name="alert" /></span>
          <span><strong>Worse:</strong> about twice the false alarms on working plugins. It rarely disagrees with the scripts, which is part of why.</span>
        </li>
      </ul>
      <p>And against everything else we tested on the same exam:</p>
    </div>
    <div class="post__figure">
      <IntervalScoreboard />
    </div>
    <div class="post__prose">
      <p class="pullquote">
        The Checker Scripts still make the call. The model has not yet met the targets we set for a full release ({model.run2.targets}),
        and closing that gap is what v0.2 is for.
      </p>
    </div>

    <div class="post__prose">
      <h2 class="post__h2" id="run">See it run</h2>
      <p>
        Real screenshots from the {hardware.name}: the model reading a plugin and writing its review on the laptop&rsquo;s own {cpu}, with
        no graphics card and no cloud.
      </p>
    </div>
    <div class="post__wide shot-grid shot-grid--run">
      {METHODOLOGY.screenshots.map((figure, index) => <Screenshot figure={figure} eager={index === 0} />)}
    </div>
    <div class="post__prose">
      <p class="chart__note">{METHODOLOGY.screenshotsNote}</p>
    </div>

    <div class="post__prose">
      <h2 class="post__h2" id="claims">What we&rsquo;re releasing, and what we&rsquo;re not claiming</h2>
    </div>
    <ul class="post__wide card-grid claims-grid">
      <li class="card">
        <span class="icon-badge icon-badge--mint"><Icon name="gift" /></span>
        <span class="badge badge--now">Releasing</span>
        <h3>The part that works, and the part that&rsquo;s learning</h3>
        <ul>
          <li>The Usuba Checker Scripts and Usuba Standard v{scripts.standardVersion}, MIT.</li>
          <li>
            Usuba Checker Model v0.1.0 (Usuba run 2): the adapter and a {model.run2.gguf} file, Apache-2.0, on <a href={SITE.adaptersHref}>Hugging Face</a>.
          </li>
          <li>The training data, the exam outputs and how to reproduce them, on <a href={SITE.datasetHref}>Hugging Face</a>.</li>
        </ul>
        <p class="claims-cta"><a class="btn btn--action btn--sm" href={SITE.getHref}>Get Usuba v0.1.0</a></p>
      </li>
      <li class="card">
        <span class="icon-badge icon-badge--pink"><Icon name="alert" /></span>
        <span class="badge badge--next">Not claiming</span>
        <h3>The limits, plainly</h3>
        <ul>
          <li>That the model makes better calls than the scripts, or better overall verdicts than its base. It doesn&rsquo;t, yet.</li>
          <li>That better format is better judgment.</li>
          {model.run2.gaps.map((gap) => <li>{gap}</li>)}
          <li>That run 2 runs well on the {hardware.short}: we haven&rsquo;t tested it there yet.</li>
        </ul>
      </li>
    </ul>

    <div class="post__prose">
      <h2 class="post__h2" id="took">What it took</h2>
      <p>
        <strong>Money.</strong> {METHODOLOGY.spend.confirmed} {METHODOLOGY.spend.provisional}
      </p>
      <p>
        <strong>Mostly, time.</strong> Calibrating a grader against a real laptop, sweeping thousands of plugins, chasing bugs through
        git histories, building a training set with a source on every row. Very little of it was GPUs. A specialist model isn&rsquo;t a
        weekend fine-tune; it&rsquo;s an ongoing investment in data and evaluation, and the evaluation is the part that lasts.
      </p>
      <p>
        Separately from all of this, Brian Armstrong personally gave $1 million to the Omacom Foundation, which funds the Omarchy stack
        Usuba builds on.
      </p>
      <h3 class="post__h3">What we&rsquo;d tell anyone trying this</h3>
      <ul class="lesson-list">{METHODOLOGY.lessons.map((lesson) => <li>{lesson}</li>)}</ul>

      <h2 class="post__h2" id="help">Help us</h2>
      <Callout kind="tip" title="Most useful">
        A plugin the Checker Scripts got wrong on your machine, especially one that loads fine and breaks when you click it.
      </Callout>
      <ul class="help-list">
        <li><strong>Plugin authors:</strong> run the scripts on your plugins and report false passes and false fails.</li>
        <li><strong>Omarchy maintainers:</strong> check the rules against your intent, and tell us when a release changes what works.</li>
        <li><strong>Anyone:</strong> labelled bugs and false alarms from real plugins, and evaluation time for the next run.</li>
      </ul>
      <div class="btn-row">
        <Button href={`${SITE.scriptsRepoHref}/issues`} external>Report a plugin</Button>
        <Button href={SITE.modelsRepoHref} variant="info" external>The model repo</Button>
      </div>
      <p class="post__signoff">Harris Kenny, OutboundSync</p>
    </div>

    <div class="post__prose">
      <h2 class="post__h2" id="source">Appendix: the original charts</h2>
      <p>The charts above are redrawn from the same data. These are the originals from the research repo, with their footnotes.</p>
    </div>
    <div class="post__wide shot-grid shot-grid--2">
      {METHODOLOGY.sourceCharts.map((figure) => <Screenshot figure={figure} />)}
    </div>
  </article>

  <section class="container section" aria-label="Get started">
    <CtaBand />
  </section>
</Base>
