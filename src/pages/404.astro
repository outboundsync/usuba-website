---
import Button from '../components/Button.astro';
import EmptyState from '../components/EmptyState.astro';
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---

<Base title="This page wandered off · Usuba" noindex>
  <div class="container nf">
    <EmptyState pose="oops" title="This page wandered off" headingLevel="h1">
      <p slot="body">The link may be old or mistyped. Try the Checker Scripts, or head back home.</p>
      <Button slot="actions" href="/" variant="info" size="sm">Go home</Button>
      <Button slot="actions" href={SITE.checkerHref} size="sm">Try the Checker Scripts</Button>
    </EmptyState>
  </div>
</Base>
