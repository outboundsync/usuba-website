---
import { existsSync } from 'node:fs';
import path from 'node:path';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { DISCOVERY, SITE } from '../data/site';
import { markdownUrlFor } from '../lib/urls';

import '@fontsource/m-plus-rounded-1c/latin-500.css';
import '@fontsource/m-plus-rounded-1c/latin-700.css';
import '@fontsource/m-plus-rounded-1c/latin-800.css';
import '@fontsource/m-plus-1-code/latin-500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/charts.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Social card under public/, rendered by `npm run make:images`. Defaults to the site card. */
  image?: string;
  imageAlt?: string;
  /** "article" for the long-form post, "website" for everything else. */
  ogType?: 'website' | 'article';
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  image = '/og.png',
  imageAlt = 'Usuba: a local model trained on, and built for, Omarchy. Usuba Checker Scripts v0.1.0 and Usuba Checker Model v0.1.0, out now.',
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.origin).href;
// Resolved from the project root: import.meta.url points into the build output at build time.
const ogImagePath = path.join(process.cwd(), 'public', image);
const hasOgImage = existsSync(ogImagePath);
const ogImage = hasOgImage ? new URL(image, SITE.origin).href : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownUrlFor(Astro.url.pathname)} />}
    <link
      rel="service-desc"
      href={DISCOVERY.agentDiscovery}
      type="application/json"
      title="Usuba agent discovery"
    />
    <link rel="describedby" href={DISCOVERY.contentIndex} />
    <meta name="theme-color" content="#ffe1ec" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && <meta name="twitter:image:alt" content={imageAlt} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="container">
      <Header />
    </div>
    <main id="main">
      <slot />
    </main>
    <div class="container">
      <Footer />
    </div>

    <script>
      import '../scripts/webmcp';
    </script>
  </body>
</html>
