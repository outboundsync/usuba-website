---
import { RESULTS } from '../data/results';

/** The reference laptop, spelled out: every "works" or "broken" label on the site comes from runs on it. */
const { hardware } = RESULTS;
---

<figure class="machine">
  <figcaption class="machine__head">
    <span class="machine__title">The test machine: {hardware.name}</span>
    <span class="machine__sub">Every hardware label on this site comes from runs on this one laptop.</span>
  </figcaption>
  <dl class="machine__specs">
    {
      hardware.specs.map((spec) => (
        <div class="machine__spec">
          <dt>{spec.label}</dt>
          <dd>{spec.value}</dd>
        </div>
      ))
    }
  </dl>
</figure>
