---
import { RESULTS } from '../data/results';
import { SITE } from '../data/site';

/** One per page, in the hero, linking to the downloads. */
const { scripts, model } = RESULTS.releases;
---

<a class="status-pill" href={SITE.getHref}>
  <span>Out now: the Usuba Checker Scripts v{scripts.version} and the Usuba Checker Model v{model.version}.</span>
</a>
