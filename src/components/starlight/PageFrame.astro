---
import Footer from '../Footer.astro';
import Search from './Search.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="page sl-flex" data-docs-page>
  <div class="header" data-docs-header-shell>
    <slot name="header" />
  </div>
  {
    hasSidebar && (
      <nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
        <button
          type="button"
          class="sl-flex md:sl-hidden print:hidden sl-menu-button"
          data-docs-menu-button
          aria-controls="starlight__sidebar"
          aria-expanded="false"
        >
          <svg class="open-menu" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 8h18a1 1 0 1 0 0-2H3a1 1 0 0 0 0 2Zm18 8H3a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Zm0-5H3a1 1 0 0 0 0 2h18a1 1 0 0 0 0-2Z" />
          </svg>
          <svg class="close-menu" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="m13.41 12 6.3-6.29a1.004 1.004 0 1 0-1.42-1.42L12 10.59l-6.29-6.3a1.004 1.004 0 0 0-1.42 1.42l6.3 6.29-6.3 6.29a1 1 0 0 0 0 1.42.998.998 0 0 0 1.42 0l6.29-6.3 6.29 6.3a.999.999 0 0 0 1.42 0 1 1 0 0 0 0-1.42L13.41 12Z" />
          </svg>
          <span class="sr-only">Menu</span>
        </button>
        <div id="starlight__sidebar" class="sidebar-pane" data-docs-sidebar-pane>
          <div class="sidebar-content sl-flex">
            <slot name="sidebar" />
          </div>
        </div>
      </nav>
    )
  }
  <div id="main" class="main-frame" data-docs-main-frame>
    <div class="docs-search-mount" data-docs-search-mount>
      <Search />
    </div>
    <slot />
  </div>
  <div class="site-footer-wrap" data-docs-site-footer>
    <Footer />
  </div>
</div>

<script>
  import '../../scripts/webmcp';
</script>

<script>
  const page = document.querySelector('[data-docs-page]');
  const button = document.querySelector('[data-docs-menu-button]');
  if (page instanceof HTMLElement && button instanceof HTMLButtonElement) {
    const setOpen = (next: boolean) => {
      page.toggleAttribute('data-mobile-menu-expanded', next);
      button.setAttribute('aria-expanded', next ? 'true' : 'false');
    };

    setOpen(false);
    button.addEventListener('click', () => setOpen(!page.hasAttribute('data-mobile-menu-expanded')));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && page.hasAttribute('data-mobile-menu-expanded')) {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>

<style is:global>
  /* The docs shell sits beside the marketing site; both speak the Kawaii tokens. */
  /* Starlight's own PageFrame is a grid; the override has to re-column it, or the
     footer is laid out beside the content and overflows narrow viewports. */
  .page {
    flex-direction: column;
    min-height: 100vh;
  }

  [data-docs-header-shell] {
    position: fixed;
    inset-inline-start: 0;
    inset-block-start: 0;
    width: 100%;
    height: var(--usuba-docs-header-height);
    z-index: 60;
    padding: 0;
    overflow: visible;
    background: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-outline);
  }

  [data-docs-header-shell] .site-header {
    max-width: var(--container);
    margin: 0 auto;
    padding-inline: var(--gutter);
    height: 100%;
    padding-block: 0;
    flex-wrap: nowrap;
  }

  [data-docs-header-shell] .logo img {
    width: 32px;
    height: 32px;
  }

  [data-docs-header-shell] .logo span {
    font-size: 1.375rem;
  }

  [data-docs-header-shell] .nav {
    gap: var(--space-5);
  }

  [data-docs-main-frame] {
    padding-top: calc(var(--usuba-docs-header-height) + var(--sl-mobile-toc-height, 0px));
    padding-inline-start: var(--sl-content-inline-start, 0px);
  }

  [data-docs-site-footer] {
    position: relative;
    z-index: 61;
  }

  [data-docs-sidebar-pane] {
    display: none !important;
  }

  [data-mobile-menu-expanded] [data-docs-sidebar-pane] {
    display: block !important;
  }

  @media (min-width: 50rem) {
    [data-docs-sidebar-pane] {
      display: block !important;
    }

    [data-docs-menu-button] {
      display: none !important;
    }
  }

  .docs-search-mount,
  [data-docs-search-mount] {
    flex-shrink: 0;
    width: 100%;
    position: relative;
  }

  @media (max-width: 49.999rem) {
    .docs-search-mount,
    [data-docs-search-mount] {
      padding: 0.75rem var(--sl-content-pad-x, 1rem);
      box-sizing: border-box;
      min-height: 4.25rem;
    }
  }

  @media (min-width: 50rem) {
    .docs-search-mount,
    [data-docs-search-mount] {
      z-index: calc(var(--sl-z-index-menu) + 1);
      position: fixed;
      top: var(--usuba-docs-header-height);
      inset-inline-start: 0;
      width: var(--sl-sidebar-width);
      padding: 1rem var(--sl-sidebar-pad-x, 1rem) 0.25rem;
      border-inline-end: var(--border-width) solid var(--color-outline);
      background: var(--color-surface);
    }

    [data-docs-sidebar-pane] .sidebar-content {
      padding-top: 4.75rem;
    }
  }

  .sl-menu-button {
    position: fixed;
    z-index: 70;
    inset-block-start: calc((var(--usuba-docs-header-height) - 2.5rem) / 2);
    inset-inline-end: var(--sl-nav-pad-x, 1rem);
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-icon);
    background: transparent;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
    pointer-events: auto;
  }

  .sl-menu-button:not([aria-expanded='true']) .close-menu {
    display: none;
  }

  .sl-menu-button[aria-expanded='true'] .open-menu {
    display: none;
  }

  .sidebar-pane {
    border: unset;
    padding: unset;
    height: unset;
    color: unset;
    position: fixed;
    z-index: 62;
    inset-block: var(--usuba-docs-header-height) 0;
    inset-inline-start: 0;
    width: 100%;
    background-color: var(--color-bg);
    overflow-y: auto;
    scrollbar-gutter: stable;
  }

  .sidebar-content {
    height: 100%;
    min-height: max-content;
    padding: 1rem var(--sl-sidebar-pad-x) 0;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 50rem) {
    .sidebar-pane {
      display: block;
      width: var(--sl-sidebar-width);
      background-color: var(--color-surface);
      border-inline-end: var(--border-width) solid var(--color-outline);
    }
  }
</style>
